@page "/"
@rendermode InteractiveServer
@namespace Piscine.Components.Components.Pages
@using Piscine.App.Board
@using Piscine.App.Progress
@using Piscine.App.Push
@using Piscine.Components.Components.Board
@using Piscine.Components.Components.Progress
@using Piscine.Components.Services
@using Piscine.Core.Content
@using Piscine.Core.Progression
@inject CourseCatalog Catalog
@inject ProgressService Progress
@inject IPushResultWatcher Pushes
@inject Piscine.Core.PiscineLayout Layout

<PageTitle>Piscine .NET — Tableau de bord</PageTitle>

<section class="hero" data-testid="dashboard">
    <h1>Tableau de bord</h1>
    <p>Centre de contrôle Asteria — progresse mission après mission.</p>
</section>

<GamificationPanel Summary="_gamification" />

@if (_resume is { } r)
{
    <a class="board-resume" data-testid="board-resume" href="/module/@r.ModuleId/@r.ExerciseId">
        <div class="br-text">
            <span class="br-label">Reprendre où tu en étais</span>
            <span class="br-exo">@r.ModuleNumber · @r.Title</span>
        </div>
        <StatusBadge Status="r.Status" />
    </a>
}
else
{
    <p class="board-alldone" data-testid="board-alldone">Tout est à jour. Beau travail&nbsp;✅</p>
}

<RushSpotlight Item="_recommendedRush" Counts="_rushCounts" Milestone="_recommendedMilestone" />

<BoardOverview Counts="_counts" Modules="_modules" />
<BoardRecent Recent="_recent" />

@code {
    private (string ModuleId, string ExerciseId, string ModuleNumber, string Title, ExerciseProgressStatus Status)? _resume;
    private BoardCounts _counts = BoardCounts.From([]);
    private IReadOnlyList<ModuleProgress> _modules = [];
    private PushResult? _recent;
    private GamificationSummary _gamification = new(0, 1, 0, 250, 0, 0, []);
    private BoardCounts _rushCounts = BoardCounts.From([]);
    private RushProgressItem? _recommendedRush;
    private CourseModule? _recommendedMilestone;

    protected override void OnInitialized()
    {
        var exos = Catalog.Modules
            .SelectMany(m => m.Groups.SelectMany(g => g.Exercises))
            .Select(ex => (ex.ModuleId, ex.Id))
            .ToList();

        var allTargets = exos
            .Concat(Catalog.Rushes.Select(rush => (ContentLocator.RushesModuleId, rush.Id)))
            .ToList();
        var snapshot = Progress.SnapshotFor(allTargets);
        var status = new Dictionary<(string, string), ExerciseProgressStatus>();
        foreach (var info in snapshot)
        {
            status[(info.ModuleId, info.ExerciseId)] = info.Status;
        }

        _counts = BoardCounts.From(exos
            .Select(exercise => status.GetValueOrDefault(exercise, ExerciseProgressStatus.NonCommence))
            .ToList());

        _modules = Catalog.Modules
            .Where(m => m.HasExercises)
            .Select(m =>
            {
                var ids = m.Groups.SelectMany(g => g.Exercises).Select(e => e.Id).ToList();
                var done = ids.Count(id => status.GetValueOrDefault((m.Id, id)) == ExerciseProgressStatus.PousseNote);
                return new ModuleProgress(m.Number, m.Title, done, ids.Count, m.Arc, m.Id);
            })
            .ToList();

        if (ResumeSelector.Pick(exos, status) is { } p)
        {
            var module = Catalog.GetModule(p.ModuleId);
            var exo = Catalog.GetExercise(p.ModuleId, p.ExerciseId);
            _resume = (p.ModuleId, p.ExerciseId, module?.Number ?? string.Empty, exo?.Title ?? p.ExerciseId,
                status.GetValueOrDefault((p.ModuleId, p.ExerciseId), ExerciseProgressStatus.NonCommence));
        }

        _recent = Pushes.LatestResult();

        var progress = new ProgressStore(Layout.ProgressPath).Load();
        var rushItems = RushProgressCalculator.Build(Catalog, snapshot, progress);
        _rushCounts = RushProgressCalculator.Counts(rushItems);
        _recommendedRush = RushProgressCalculator.Recommend(rushItems);
        _recommendedMilestone = _recommendedRush is null
            ? null
            : Catalog.GetRecommendedModule(_recommendedRush.Rush);

        var gameExercises = Catalog.Modules
            .SelectMany(module => module.Groups.SelectMany(group => group.Exercises))
            .Select(exercise => new GamificationExercise(
                exercise.ModuleId,
                exercise.Id,
                exercise.Xp,
                exercise.Bonus,
                exercise.Tags))
            .Concat(Catalog.Rushes.Select(rush => new GamificationExercise(
                Piscine.Core.Content.ContentLocator.RushesModuleId,
                rush.Id,
                rush.Xp,
                rush.Bonus,
                rush.Tags)))
            .ToList();
        _gamification = GamificationCalculator.Calculate(
            gameExercises,
            progress,
            DateOnly.FromDateTime(DateTime.Now));
    }
}
